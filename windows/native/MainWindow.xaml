<Window x:Class="SSHClient.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ssh-client" Height="820" Width="1280" MinHeight="540" MinWidth="720"
        Style="{StaticResource AppWindow}"
        WindowStyle="None" AllowsTransparency="False"
        Loaded="Window_Loaded" PreviewKeyDown="Window_KeyDown" PreviewMouseDown="Window_MouseDown" SizeChanged="Window_SizeChanged">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Grid Background="{DynamicResource Surface}">

    <!-- ===================================================================== -->
    <!-- 1. AUTHENTICATION / MASTER VAULT UNLOCK (Email + Password)           -->
    <!-- ===================================================================== -->
    <!-- ===================================================================== -->
    <!-- 2. MAIN APPLICATION WORKSPACE                                         -->
    <!-- ===================================================================== -->
    <Grid x:Name="MainAppGrid" Visibility="Visible">
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>

      <!-- Window Titlebar with Central Omnibar and Window Controls -->
      <Grid Grid.Row="0" Background="{DynamicResource Surface}">
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"/>
        <Grid Margin="12,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Left: App Identity -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource CardLow}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
              <TextBlock Text="SSH" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
            </Border>
            <TextBlock Text="ssh-client" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
            <TextBlock Text=" / " Foreground="{DynamicResource MutedSubtle}" Margin="4,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="AppVersionLabel" Text="" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Center: Omnibar (Ctrl+K) -->
          <Border Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="480" MinWidth="0" Margin="10,0" Height="30" Background="{DynamicResource CardLow}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid VerticalAlignment="Center">
              <TextBox x:Name="OmniBar" AutomationProperties.Name="Search hosts and commands" Style="{StaticResource OmniTextBox}" Height="30" BorderThickness="0" Background="Transparent" Padding="10,0,80,0" VerticalContentAlignment="Center" KeyDown="OmniBar_KeyDown" ToolTip="Quick connect (user@host:port) or search hosts [Ctrl+K]"/>
              <TextBlock x:Name="OmniHint" Text="Quick connect (user@host:port) or search... [Ctrl+K]" Foreground="{DynamicResource MutedSubtle}" FontSize="11" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                <TextBlock Text="SSH://" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
              </Border>
            </Grid>
          </Border>

          <!-- Right: Live Daemon Pill, Theme Toggle, Window Caption Controls -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
            <!-- Theme Toggle Button -->
            <Button x:Name="ThemeToggleBtn" Content="Theme" Click="ThemeToggle_Click" Style="{StaticResource GhostButton}" Height="28" Margin="0,0,8,0" Padding="10,0" ToolTip="Switch dark and light themes"/>

            <!-- Window Caption Controls -->
            <Button Content="&#xE921;" Click="Minimize_Click" Style="{StaticResource CaptionButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
            <Button x:Name="MaximizeBtn" Content="&#xE922;" Click="Maximize_Click" Style="{StaticResource CaptionButton}" ToolTip="Maximize" AutomationProperties.Name="Maximize or restore"/>
            <Button Content="&#xE8BB;" Click="Close_Click" Style="{StaticResource CloseCaptionButton}" ToolTip="Close" AutomationProperties.Name="Close application"/>
          </StackPanel>
        </Grid>
      </Grid>

      <Popup x:Name="PalettePopup" PlacementTarget="{Binding ElementName=OmniBar}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12" CornerRadius="6" MaxWidth="480" Width="420">
          <StackPanel>
            <TextBlock Text="Hosts and commands" FontWeight="Bold" Margin="0,0,0,8"/>
            <ListBox x:Name="PaletteList" MaxHeight="320" DisplayMemberPath="Label" MouseDoubleClick="PaletteRun_Click" KeyDown="Palette_KeyDown"/>
            <TextBlock Text="Arrow keys to select. Enter to run. Escape to close." Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Popup>
      <!-- Main Body: Sidebar + Multi-Page Content Area -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160" MinWidth="180" MaxWidth="240"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Rail (5 Core Pages) -->
        <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
          <DockPanel Margin="10,12,10,12">
            <!-- Pinned Bottom Section: Active Terminals + Supervisor Node -->
            <StackPanel DockPanel.Dock="Bottom">
              <!-- Active Terminals (shows when openSessions > 0) -->
              <StackPanel x:Name="ActiveTerminalsSection" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock Text="OPEN TERMINALS" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedSubtle}" Margin="4,0,0,6"/>
                <ListBox x:Name="SidebarSessionsList" MaxHeight="120" SelectionChanged="SidebarSessions_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="8,6" Background="{DynamicResource CardLow}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,4">
                        <DockPanel>
                          <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentCyan}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                          <TextBlock Text="" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedSubtle}" HorizontalAlignment="Right"/>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>


            </StackPanel>

            <!-- Navigation Items (5 Primary Pages) -->
            <StackPanel>
              <TextBlock Text="WORKSPACE" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedSubtle}" Margin="8,0,0,10"/>

              <!-- 1. Dashboard -->
              <Button x:Name="NavDashboard" Click="NavDashboard_Click" Style="{StaticResource NavButton}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Overview" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </Grid>
              </Button>

              <!-- 2. Hosts -->
              <Button x:Name="NavHosts" Click="NavHosts_Click" Style="{StaticResource NavButton}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Hosts" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="2,0,0,0"/>
                  <Border Grid.Column="2" Background="{DynamicResource CardLow}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                    <TextBlock x:Name="SidebarHostBadge" Text="0" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                  </Border>
                </Grid>
              </Button>

              <!-- 3. SFTP -->
              <Button x:Name="NavSftp" Click="NavSftp_Click" Style="{StaticResource NavButton}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="&#xED25;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Files" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="2,0,0,0"/>
                  <TextBlock Grid.Column="2" Text="↗" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedSubtle}" VerticalAlignment="Center"/>
                </Grid>
              </Button>

              <!-- 4. Keys -->
              <Button x:Name="NavKeys" Click="NavKeys_Click" Style="{StaticResource NavButton}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="&#xE8D7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="SSH keys" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="2,0,0,0"/>
                  <Border Grid.Column="2" Background="{DynamicResource CardLow}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                    <TextBlock x:Name="SidebarKeysBadge" Text="4" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentYellow}"/>
                  </Border>
                </Grid>
              </Button>

              <!-- 5. Settings -->
              <Button x:Name="NavSettings" Click="NavSettings_Click" Style="{StaticResource NavButton}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Settings" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </Grid>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Right Workspace: Multi-Page Content Area -->
        <Grid Grid.Column="1">

          <!-- TAB 1: DASHBOARD / COMMAND CENTER -->
          <Grid x:Name="DashboardPage" Visibility="Visible">
            <DockPanel Margin="24,20">
              <!-- Dashboard Header -->
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Overview" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="LOCAL WORKSPACE" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="Saved hosts, current connections and local SSH identities" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Content="Refresh" Click="RefreshDashboard_Click" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Height="32" Padding="12,0"/>
                  <Button Content="+ Add host" Click="DashboardNewHost_Click" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0"/>
                </StackPanel>
              </DockPanel>

              <!-- 4 System Metric Cards -->
              <UniformGrid x:Name="DashboardCards" Columns="4" DockPanel.Dock="Top" Margin="0,0,0,20">


                <!-- Metric 1: Saved Hosts -->
                <Border Grid.Column="0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="SAVED HOSTS" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                      <TextBlock Text="" HorizontalAlignment="Right" Foreground="{DynamicResource AccentCyan}"/>
                    </DockPanel>
                    <TextBlock x:Name="MetricHostsCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,8,0,2"/>
                    <TextBlock Text="Configured endpoints" FontSize="11" Foreground="{DynamicResource MutedSubtle}"/>
                    <Separator Background="{DynamicResource Border}" Margin="0,10,0,8"/>
                    <TextBlock x:Name="MetricHostsBreakdown" Text="UBNT • DEB • ALP • RHEL" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource AccentCyan}"/>
                  </StackPanel>
                </Border>

                <!-- Metric 2: Active Sessions -->
                <Border Grid.Column="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4,0,4,0">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="ACTIVE SESSIONS" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                      <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="MetricActiveSessions" Text="0" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,8,0,2"/>
                    <TextBlock Text="Connected terminal tabs" FontSize="11" Foreground="{DynamicResource MutedSubtle}"/>
                    <Separator Background="{DynamicResource Border}" Margin="0,10,0,8"/>
                    <TextBlock Text="" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Accent}"/>
                  </StackPanel>
                </Border>

                <!-- Metric 3: Key Vault -->
                <Border Grid.Column="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4,0,4,0">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="SSH keys" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                      <TextBlock Text="" HorizontalAlignment="Right" Foreground="{DynamicResource AccentYellow}"/>
                    </DockPanel>
                    <TextBlock x:Name="MetricKeysCount" Text="4" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,8,0,2"/>
                    <TextBlock Text="SSH Keypairs Registered" FontSize="11" Foreground="{DynamicResource MutedSubtle}"/>
                    <Separator Background="{DynamicResource Border}" Margin="0,10,0,8"/>
                    <TextBlock Text="Public metadata only" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Text}"/>
                  </StackPanel>
                </Border>

                <!-- Metric 4: Supervisor Node -->
                <Border Grid.Column="3" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="LOCAL SERVICE" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                      <TextBlock Text="" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}"/>
                    </DockPanel>
                    <TextBlock x:Name="BackendReadyText" Text="Starting" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,8,0,2"/>
                    <TextBlock Text="" FontSize="11" Foreground="{DynamicResource MutedSubtle}"/>
                    <Separator Background="{DynamicResource Border}" Margin="0,10,0,8"/>
                    <TextBlock Text="" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <!-- Quick Connect Action Bar -->
              <Border DockPanel.Dock="Top" Background="{DynamicResource CardLow}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                <DockPanel>
                  <TextBlock Text="QUICK CONNECT" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                  <Button Content="Connect" Click="QuickConnect_Click" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Height="34" Width="90"/>
                  <TextBox x:Name="QuickConnectInput" AutomationProperties.Name="Quick connection endpoint" Height="34" Margin="0,0,12,0" Text="root@192.168.1.100:22" FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center"/>
                </DockPanel>
              </Border>

              <!-- Recent Hosts Table / Grid -->
              <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="RECENT &amp; SAVED ENDPOINTS" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <Button Content="View all hosts →" Click="NavHosts_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="0"/>
                  </DockPanel>

                  <ListBox x:Name="DashboardHostsList" SelectionMode="Single" SelectionChanged="DashboardHosts_SelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                          <DockPanel>
                            <Border Background="{DynamicResource CardLow}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Width="54" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding OsBadge}" ToolTip="Label inferred from host name and tags" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource HostTextWidth}}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text}"/>
                              <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource HostTextWidth}}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Port, StringFormat=':{0}'}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedSubtle}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                              <Button Content=" Connect" Tag="{Binding}" Click="DashboardConnect_Click" Style="{StaticResource PrimaryButton}" Height="28" Padding="12,0"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </DockPanel>
          </Grid>

          <!-- TAB 2: HOSTS INVENTORY & INSPECTOR -->
          <Grid x:Name="HostsPage" Visibility="Collapsed">

            <!-- List View Mode -->
            <Grid x:Name="HostListGrid" Visibility="Visible">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="300"/>
              </Grid.ColumnDefinitions>

              <!-- Left Main Column: Hosts Catalog -->
              <DockPanel Grid.Column="0" Margin="24,20,16,20">
                <!-- Header with Action -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Hosts" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                    <TextBlock x:Name="HostCount" Text="0 configured hosts" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button Content="Import SSH config" Click="ImportSshConfig_Click" HorizontalAlignment="Right" Margin="8,0"/>
                  <Button Content="Details" Click="ToggleInspector_Click" Margin="6,0" HorizontalAlignment="Right"/>
                  <Button Content="+ New host" Click="NewHost_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Height="32" Padding="14,0"/>
                </DockPanel>

                <!-- Search and Filters Bar -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                  <!-- Tag Filter Buttons -->
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0">
                    <Button x:Name="FilterAll" Content="All" Click="FilterAll_Click" Style="{StaticResource OutlineButton}" Height="34" Padding="12,0" Margin="0,0,6,0"/>
                    <Button x:Name="FilterFav" Content="Favorites" Click="FilterFav_Click" Style="{StaticResource OutlineButton}" Height="34" Padding="12,0"/>
                  </StackPanel>

                  <!-- Search Box -->
                  <Grid VerticalAlignment="Center">
                    <TextBox x:Name="Search" AutomationProperties.Name="Filter saved hosts" Height="34" TextChanged="Search_Changed" Padding="10,0" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="SearchHint" Text="Search hosts by name, address, or tag..." Foreground="{DynamicResource MutedSubtle}" FontSize="12" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  </Grid>
                </DockPanel>

                <TextBlock x:Name="HostsEmpty" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
<Button x:Name="HostGridButton" Content="Grid" Click="HostGrid_Click" AutomationProperties.Name="Show host cards" Margin="0,0,8,0"/>
<Button x:Name="HostListButton" Content="List" Click="HostList_Click" AutomationProperties.Name="Show host list"/>
</StackPanel><ComboBox x:Name="HostSort"  SelectedIndex="0" SelectionChanged="HostSort_Changed" HorizontalAlignment="Left" Margin="0,0,0,8" Width="180" AutomationProperties.Name="Sort hosts">
                  <ComboBoxItem Content="Name" Tag="name"/><ComboBoxItem Content="Recent connections" Tag="recent"/><ComboBoxItem Content="Favorites first" Tag="favorite"/>
                </ComboBox></DockPanel>
                <!-- Hosts List -->
                <ListBox x:Name="Hosts" SelectionChanged="Hosts_SelectionChanged" AutomationProperties.Name="Saved hosts">
                  <ListBox.ContextMenu><ContextMenu><MenuItem Header="Connect" Click="DetailConnect_Click"/><MenuItem Header="Edit" Click="DetailEdit_Click"/><MenuItem Header="Favorite" Click="DetailFavorite_Click"/><MenuItem Header="Delete" Click="DetailRemove_Click"/></ContextMenu></ListBox.ContextMenu>
                  <ListBox.Resources>
                    <DataTemplate x:Key="HostListTemplate">
                      <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,2">
                        <DockPanel>
                          <!-- Distro Badge -->
                          <Border Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Width="54" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OsBadge}" ToolTip="Label inferred from host name and tags" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>

                          <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource HostTextWidth}}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text}"/>
                              <TextBlock Text="Favorite" Foreground="{DynamicResource AccentYellow}" FontSize="12" Margin="8,0,0,0" Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource HostTextWidth}}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                          </StackPanel>

                          <!-- Right Tags & Port -->
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Port, StringFormat=':{0}'}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedSubtle}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <Button Content="Connect" Tag="{Binding}" Click="HostItemConnect_Click" Style="{StaticResource PrimaryButton}" Height="28" Padding="14,0"/>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  <DataTemplate x:Key="HostGridTemplate">
                      <Border x:Name="HostCardSurface" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="18">
    <StackPanel>
      <DockPanel Margin="0,0,0,16">
        <TextBlock DockPanel.Dock="Right" Text="Favorite" Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource AccentCyan}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <Border Width="58" Height="34" HorizontalAlignment="Left" Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
          <TextBlock Text="{Binding OsBadge}" ToolTip="Label inferred from host name and tags" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
      </DockPanel>
      <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}" ToolTip="{Binding Name}"/>
      <TextBlock Text="{Binding Description}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/>
      <TextBlock Text="{Binding TagSummary}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedSubtle}" Margin="0,8,0,16"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Details" Tag="{Binding}" Click="HostCardDetails_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
        <Button Content="Connect" Tag="{Binding}" Click="HostItemConnect_Click" Style="{StaticResource PrimaryButton}"/>
      </DockPanel>
    </StackPanel>
  </Border>
<DataTemplate.Triggers>
  <Trigger SourceName="HostCardSurface" Property="IsMouseOver" Value="True">
    <Setter TargetName="HostCardSurface" Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
  </Trigger>
</DataTemplate.Triggers>
</DataTemplate></ListBox.Resources>
                </ListBox>
              </DockPanel>

              <!-- Right Column: Host Detail Inspector -->
              <Border x:Name="HostInspector" Grid.Column="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <ScrollViewer Margin="20">
                  <StackPanel x:Name="InspectorPanel">
                    <TextBlock Text="INSPECTOR" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedSubtle}" Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                      <StackPanel>
                        <TextBlock x:Name="DetailTitle" Text="Select a host" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Text}"/>
                        <TextBlock x:Name="DetailSubtitle" Text="Choose a server to inspect configuration" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>

                    <!-- Specs List -->
                    <Border Background="{DynamicResource CardLow}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock Text="Address" Foreground="{DynamicResource MutedSubtle}" FontSize="11"/>
                          <TextBlock x:Name="DetailAddress" Text="-" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text}" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock Text="Port" Foreground="{DynamicResource MutedSubtle}" FontSize="11"/>
                          <TextBlock x:Name="DetailPort" Text="22" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text}" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock Text="Username" Foreground="{DynamicResource MutedSubtle}" FontSize="11"/>
                          <TextBlock x:Name="DetailUser" Text="-" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text}" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel>
                          <TextBlock Text="Auth Mode" Foreground="{DynamicResource MutedSubtle}" FontSize="11"/>
                          <TextBlock x:Name="DetailAuth" Text="Keypair" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentCyan}" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>
                      </StackPanel>
                    </Border>

                    <!-- Inspector Actions -->
                    <Button x:Name="DetailConnectBtn" Content="Connect Terminal" Click="DetailConnect_Click" Style="{StaticResource PrimaryButton}" Height="36" Margin="0,0,0,8"/>
                    <Button x:Name="DetailEditBtn" Content="Edit Configuration" Click="DetailEdit_Click" Style="{StaticResource OutlineButton}" Height="34" Margin="0,0,0,8"/>
                    <Button x:Name="DetailFavBtn" Content="Toggle Favorite" Click="DetailFavorite_Click" Style="{StaticResource GhostButton}" Height="30" Margin="0,0,0,8"/>
                    <Button x:Name="DetailRemoveBtn" Content="Delete Host" Click="DetailRemove_Click" Style="{StaticResource GhostButton}" Foreground="#EF4444" Height="30"/>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>

            <!-- Full-Page Host Editor Mode -->
            <Grid x:Name="HostEditorGrid" Visibility="Collapsed" Background="{DynamicResource Surface}">
              <DockPanel MaxWidth="680" HorizontalAlignment="Left">
                <StackPanel DockPanel.Dock="Bottom" Margin="24,12">
                  <TextBlock x:Name="EditorError" Foreground="{DynamicResource AccentYellow}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                  <WrapPanel>
                    <Button Content="Save and connect" Click="EditorSaveAndConnect_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/>
                    <Button Content="Save host" Click="EditorSave_Click" Margin="0,0,12,0"/>
                    <Button Content="Cancel" Click="EditorCancel_Click"/>
                  </WrapPanel>
                </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Margin="24,16">
                  <StackPanel>
                    <Button Content="← Back to hosts" Click="EditorCancel_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                    <TextBlock x:Name="EditorHeader" Text="New host" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="Enter an address or paste user@host:port. Choose how to sign in." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,16"/>

                    <!-- Section 1: Server Details -->
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                      <StackPanel>
                        <TextBlock Text="SERVER DETAILS" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Label Content="_Server address" Target="{Binding ElementName=EditorHost}" Padding="0" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                            <TextBox x:Name="EditorHost" AutomationProperties.Name="Server address" Height="34"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <Label Content="SSH _port" Target="{Binding ElementName=EditorPort}" Padding="0" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                            <TextBox x:Name="EditorPort" AutomationProperties.Name="SSH port" Text="22" Height="34"/>
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="Remote Username" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EditorUser" AutomationProperties.Name="Remote username" Height="34" Margin="0,0,0,12"/>

                        <TextBlock Text="Authentication method" Margin="0,0,0,4"/>
                        <ComboBox x:Name="EditorAuth" AutomationProperties.Name="Authentication method" SelectedIndex="0" Margin="0,0,0,12" SelectionChanged="EditorAuth_Changed">
                          <ComboBoxItem Content="SSH key" Tag="key"/>
                          <ComboBoxItem Content="Password" Tag="password"/>
                          <ComboBoxItem Content="Keyboard interactive" Tag="keyboard_interactive"/>
                        </ComboBox>
                        <TextBlock x:Name="EditorAuthHint" Text="Choose an existing private key. Its contents stay on this computer." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                        <StackPanel x:Name="EditorKeySection">
                          <TextBlock Text="Choose a key" Margin="0,0,0,4"/>
                          <ComboBox x:Name="EditorIdentity" AutomationProperties.Name="SSH key on this computer or saved key" DisplayMemberPath="SelectionLabel" SelectionChanged="EditorIdentity_Changed" Margin="0,0,0,8"/>
                          <TextBox x:Name="EditorKeyPath" AutomationProperties.Name="Private key file" IsReadOnly="True" Visibility="Collapsed"/>
                          <TextBlock x:Name="EditorKeyDetails" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                          <WrapPanel>
                            <Button Content="Choose another file" Click="EditorBrowseKey_Click" Margin="0,0,8,4"/>
                            <Button Content="Generate key" Click="GenerateKeypair_Click" Margin="0,0,8,4"/>
                            <Button Content="Refresh local keys" Click="DiscoverKeys_Click" Margin="0,0,0,4"/>
                          </WrapPanel>
                        </StackPanel>
                        <Label Content="Display _name (optional)" Target="{Binding ElementName=EditorName}" Padding="0" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,12,0,4"/>
                        <TextBox x:Name="EditorName" AutomationProperties.Name="Host display name" Height="34"/>
                        <TextBlock Text="Uses the server address if left blank." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>

                    <!-- Section 3: Advanced Details -->
                    <Expander x:Name="EditorAdvanced" Header="Advanced options: jump host, tags and notes" Foreground="{DynamicResource Text}" Margin="0,0,0,16">
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24">
                      <StackPanel>
                        <TextBlock Text="ADVANCED &amp; PROXY" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
                        <TextBlock Text="Jump Host (ProxyJump)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EditorJump" AutomationProperties.Name="Jump host" Height="34" Margin="0,0,0,12"/>

                        <TextBlock Text="Tags (comma-separated)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EditorTags" AutomationProperties.Name="Tags" Height="34" Margin="0,0,0,12"/>

                        <TextBlock Text="Notes" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EditorNotes" AutomationProperties.Name="Host notes" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                    </Expander>


                  </StackPanel>
                </Border>
              </ScrollViewer>
              </DockPanel>
            </Grid>
          </Grid>

          <!-- TAB 3: SFTP FILE TRANSFER CENTER -->
          <Grid x:Name="SftpPage" Visibility="Collapsed">
            <DockPanel Margin="24,20">
              <!-- SFTP Header Bar -->
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Files" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="SECURE CHANNEL" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="Dual remote/local browser with high-throughput streaming &amp; drag-and-drop" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Active Session Selector -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock Text="Target Session: " Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox x:Name="SftpSessionCombo" AutomationProperties.Name="File browser SSH session" Width="240" DisplayMemberPath="SelectionLabel" SelectionChanged="SftpSessionCombo_SelectionChanged"/>
                </StackPanel>
              </DockPanel>

              <ContentControl x:Name="SftpContent">
                <TextBlock Text="Connect a host, then choose its session to browse files." TextWrapping="Wrap" Margin="16"/>
              </ContentControl>
            </DockPanel>
          </Grid>

          <!-- TAB 4: KEY VAULT CRYPTOGRAPHIC MANAGER -->
          <Grid x:Name="KeysPage" Visibility="Collapsed">
            <DockPanel Margin="24,20">
              <!-- Key Vault Header -->
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SSH keys" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="ED25519 &amp; RSA-4096" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="Private keys stay in their selected files. Only public keys and file paths are saved here." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Content="Find local keys" Click="DiscoverKeys_Click" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                  <Button Content="Add key" Click="RegisterKey_Click" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                  <Button Content="Generate Keypair" Click="GenerateKeypair_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="14,0"/>
                </StackPanel>
              </DockPanel>

              <!-- Keys List -->
              <ListBox x:Name="KeysList">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                      <DockPanel>
                        <!-- Key Icon & Type Badge with Fixed Width for Uniform Alignment -->
                        <Border Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Width="74" Height="28" Margin="0,0,16,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding AlgorithmBadge}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource HostTextWidth}}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Text}"/>
                            <Border Background="{DynamicResource CardLow}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding SourceLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedSubtle}"/>
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Actions on Right -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                          <Button Content="Copy Public Key" Tag="{Binding}" IsEnabled="{Binding HasPublicKey}" Click="CopyPubKey_Click" Style="{StaticResource OutlineButton}" Height="28" Padding="12,0" Margin="0,0,8,0"/>
                          <Button Content="Remove" Tag="{Binding}" IsEnabled="{Binding CanRemove}" Click="RemoveKey_Click" Style="{StaticResource OutlineButton}" Foreground="#EF4444" Height="28" Padding="10,0"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>

          <!-- TAB 5: SETTINGS & PREFERENCES -->
          <Grid x:Name="SettingsPage" Visibility="Collapsed">
            <ScrollViewer Margin="24,20">
              <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                <TextBlock Text="Configure appearance, terminal emulation, and backend daemon parameters" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,24"/>

                <!-- Theme Selection Card -->
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="APPEARANCE &amp; THEME" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                      <!-- Dark Terminal Edition -->
                      <Button Content=" Dark Terminal Edition" Click="SetDarkTheme_Click" Style="{StaticResource OutlineButton}" Height="38" Padding="16,0" Margin="0,0,12,0"/>
                      <!-- Light Bauhaus Edition -->
                      <Button Content=" Light Bauhaus Edition" Click="SetLightTheme_Click" Style="{StaticResource OutlineButton}" Height="38" Padding="16,0"/>
                    </StackPanel>
                    <CheckBox x:Name="ReducedMotion" Content="Reduce animations" Margin="0,8"/>
                    <TextBlock x:Name="SettingsError" TextWrapping="Wrap" Foreground="{DynamicResource AccentYellow}"/>
                    <Button Content="Save preferences" Click="SaveSettings_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>

                  </StackPanel>
                </Border>

                <!-- Terminal Typography Card -->
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="APP UPDATES" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="UpdateStatus" Text="Connect the local service to check the installed version." TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ProgressBar x:Name="UpdateProgress" AutomationProperties.Name="Update download progress" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,12"/>
                    <WrapPanel>
                      <Button x:Name="UpdateCheckButton" Content="Check for updates" Click="CheckUpdate_Click" IsEnabled="False" Margin="0,0,8,0"/>
                      <Button x:Name="UpdateInstallButton" Content="Install and restart" Click="InstallUpdate_Click" Visibility="Collapsed" Style="{StaticResource PrimaryButton}"/>
                    </WrapPanel>
                    <TextBlock Text="No uninstall needed. Saved hosts, preferences and local key files stay in place." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="TERMINAL EMULATION" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Font size (pixels)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SettingsFontSize" AutomationProperties.Name="Terminal font size" Text="13" Height="34" VerticalContentAlignment="Center"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Scrollback Lines" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SettingsScrollback" AutomationProperties.Name="Terminal scrollback lines" Text="5000" Height="34" VerticalContentAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="20" Margin="0,0,0,16" CornerRadius="8">
                  <StackPanel>
                    <TextBlock Text="WORKSPACES AND DATA" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ComboBox x:Name="WorkspaceList" AutomationProperties.Name="Saved workspace" DisplayMemberPath="Name" Margin="0,0,0,12"/>
                    <WrapPanel>
                      <Button Content="Save workspace" Click="SaveWorkspace_Click" Margin="0,0,8,8"/>
                      <Button Content="Restore workspace" Click="RestoreWorkspace_Click" Margin="0,0,8,8"/>
                      <Button Content="Back up databases" Click="Backup_Click" Margin="0,0,8,8"/>
                      <Button Content="Export hosts" Click="ExportHosts_Click" Margin="0,0,8,8"/>
                      <Button Content="Import hosts" Click="ImportHosts_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Text="Restore reconnects saved hosts after confirmation and prompts for credentials. Backups contain host, workspace, public-key metadata and preferences; private-key files and connection passwords are excluded." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="20" Margin="0,0,0,16" CornerRadius="8">
                  <StackPanel><TextBlock Text="DIAGNOSTICS" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock x:Name="DaemonStatusText" Text="Checking local service..." TextWrapping="Wrap"/>
                    <TextBlock x:Name="DaemonUptimeText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Button Content="Refresh diagnostics" Click="RefreshDiagnostics_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
                <!-- Identity & Lock Vault Card -->
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="LOCAL SESSION SECURITY" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="Passwords and key passphrases are entered for each connection and kept in memory. This app has no cloud account or master vault. Locking Windows protects access to the desktop; SSH sessions continue until disconnected or the app closes." TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="Lock Windows" Click="LockVault_Click" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- TAB 6: ACTIVE TERMINAL SESSION WORKSPACE (When connected) -->
          <Grid x:Name="SessionTerminalWorkspace" Visibility="Collapsed">
            <TabControl x:Name="SessionTabs" SelectionChanged="SessionTabs_SelectionChanged"/>
          </Grid>
        </Grid>
      </Grid>

      <Border x:Name="RecoveryPanel" Grid.Row="1" VerticalAlignment="Top" Panel.ZIndex="10" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="16" Margin="220,12,20,0" Visibility="Collapsed">
        <StackPanel><TextBlock x:Name="RecoveryMessage" TextWrapping="Wrap" Margin="0,0,0,10"/><WrapPanel>
          <Button Content="Retry" Click="RetryOperation_Click" Margin="0,0,8,0"/>
          <Button Content="Edit host" Click="RecoveryEdit_Click" Margin="0,0,8,0"/>
          <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click" Margin="0,0,8,0"/>
          <Button Content="Dismiss" Click="DismissRecovery_Click"/>
        </WrapPanel></StackPanel>
      </Border>
      <!-- Bottom Status Bar -->
      <Grid Grid.Row="2" Background="{DynamicResource CardLow}">
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"/>
        <DockPanel Margin="14,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" MaxWidth="450" Text="Ready" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="SSHv2-RFC4253" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedSubtle}" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Text="Windows x64" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedSubtle}" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
