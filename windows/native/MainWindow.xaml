<Window x:Class="SSHClient.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ssh-client" Width="1120" Height="740" MinWidth="850" MinHeight="540">
  <Grid Margin="24" Background="{StaticResource Surface}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><TextBlock Text="ssh-client" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="WINDOWS DESKTOP" FontSize="11" Foreground="#9298A4" Margin="20,14,0,0"/></StackPanel>
    <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="24"><TextBlock Text="Starting the local SSH backend..." VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#9298A4"/></Border>
    <TextBlock Grid.Row="2" Text="Local sessions. Native Windows controls." FontSize="11" Foreground="#9298A4" Margin="0,16,0,0"/>
  </Grid>
</Window>
