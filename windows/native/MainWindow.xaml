<Window x:Class="SSHClient.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ssh-client" Height="820" Width="1280" MinHeight="540" MinWidth="720" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Style="{StaticResource AppWindow}"
        WindowStyle="None" AllowsTransparency="False"
        Loaded="Window_Loaded" PreviewKeyDown="Window_KeyDown" PreviewMouseDown="Window_MouseDown" SizeChanged="Window_SizeChanged">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <DataTemplate x:Key="CollapsedSessionRow"><Border Padding="4,10" ToolTip="{Binding Summary}"><TextBlock Text="{Binding Initial}" TextAlignment="Center" Foreground="{DynamicResource AccentCyan}" FontWeight="SemiBold"/></Border></DataTemplate>
    <DataTemplate x:Key="SessionRow">
      <Grid Margin="8,7" ToolTip="{Binding Summary}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Ellipse Width="6" Height="6" VerticalAlignment="Top" Margin="0,5,0,0">
          <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource MutedSubtle}"/><Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connected"><Setter Property="Fill" Value="{DynamicResource StatusOnline}"/></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Connecting"><Setter Property="Fill" Value="{DynamicResource AccentYellow}"/></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Fill" Value="{DynamicResource StatusError}"/></DataTrigger>
          </Style.Triggers></Style></Ellipse.Style>
        </Ellipse>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding State}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="OverviewHostRow">
      <Grid Margin="12,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
          <TextBlock Text="{Binding Description}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Margin="0,4,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Connect" Tag="{Binding}" Click="DashboardConnect_Click" Style="{StaticResource GhostButton}" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid Background="{DynamicResource Surface}">

    <!-- ===================================================================== -->
    <!-- MAIN APPLICATION WORKSPACE                                            -->
    <!-- ===================================================================== -->
    <Grid x:Name="MainAppGrid" Visibility="Visible">
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>

      <!-- Window Titlebar with Central Omnibar and Window Controls -->
      <Grid Grid.Row="0" Background="{DynamicResource Surface}">
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"/>
        <Grid Margin="12,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Left: App Identity -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Opacity" Value="0.6"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Image Source="branding/icon.png" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="ssh-client logo"/>
            <TextBlock Text="ssh-client" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
            <TextBlock Text=" / " Foreground="{DynamicResource MutedSubtle}" Margin="4,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="AppVersionLabel" Text="" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Center: Omnibar (Ctrl+K) -->
          <Border Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="480" MinWidth="0" Margin="10,0" Height="30" Background="{DynamicResource CardLow}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid VerticalAlignment="Center">
              <TextBox x:Name="OmniBar" AutomationProperties.Name="Search hosts and commands" Style="{StaticResource OmniTextBox}" Height="30" BorderThickness="0" Background="Transparent" Padding="10,0,80,0" VerticalContentAlignment="Center" KeyDown="OmniBar_KeyDown" ToolTip="Quick connect (user@host:port) or search hosts [Ctrl+K]"/>
              <TextBlock x:Name="OmniHint" Text="Search or connect..." Foreground="{DynamicResource MutedSubtle}" FontSize="11" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                <TextBlock Text="Ctrl K" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
              </Border>
            </Grid>
          </Border>

          <!-- Right: Live Daemon Pill, Theme Toggle, Window Caption Controls -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
            <!-- Theme Toggle Button -->
            <Button x:Name="ThemeToggleBtn" Content="Theme" Click="ThemeToggle_Click" Style="{StaticResource GhostButton}" Height="28" Margin="0,0,8,0" Padding="10,0" ToolTip="Switch dark and light themes"/>

            <!-- Window Caption Controls -->
            <Button Content="&#xE921;" Click="Minimize_Click" Style="{StaticResource CaptionButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
            <Button x:Name="MaximizeBtn" Content="&#xE922;" Click="Maximize_Click" Style="{StaticResource CaptionButton}" ToolTip="Maximize" AutomationProperties.Name="Maximize or restore"/>
            <Button Content="&#xE8BB;" Click="Close_Click" Style="{StaticResource CloseCaptionButton}" ToolTip="Close" AutomationProperties.Name="Close application"/>
          </StackPanel>
        </Grid>
      </Grid>

      <Popup x:Name="PalettePopup" PlacementTarget="{Binding ElementName=OmniBar}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12" CornerRadius="6" MaxWidth="480" Width="420">
          <StackPanel>
            <TextBlock Text="Hosts and commands" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,0,8"/>
            <ListBox x:Name="PaletteList" MaxHeight="320" DisplayMemberPath="Label" MouseDoubleClick="PaletteRun_Click" KeyDown="Palette_KeyDown"/>
            <TextBlock Text="Arrow keys to select. Enter to run. Escape to close." Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Popup>
      <!-- Main Body: Sidebar + Multi-Page Content Area -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="204"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
          <DockPanel Margin="8,10,8,8">
            <Grid DockPanel.Dock="Top" Margin="4,0,0,10">
              <TextBlock x:Name="WorkspaceLabel" Text="Workspace" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <Button x:Name="CollapseSidebarButton" Content="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="CollapseSidebar_Click" Style="{StaticResource GhostButton}" Width="30" HorizontalAlignment="Right" ToolTip="Collapse or expand sidebar (Ctrl+Shift+B)" AutomationProperties.Name="Collapse or expand sidebar" Padding="0"/>
            </Grid>
            <StackPanel DockPanel.Dock="Top" KeyboardNavigation.DirectionalNavigation="Cycle">
<Button x:Name="NavDashboard" Click="NavDashboard_Click" Style="{StaticResource NavButton}" ToolTip="Overview" AutomationProperties.Name="Overview">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
        <TextBlock x:Name="NavDashboardLabel" Grid.Column="1" Text="Overview" VerticalAlignment="Center"/>
      </Grid></Button>
<Button x:Name="NavHosts" Click="NavHosts_Click" Style="{StaticResource NavButton}" ToolTip="Hosts" AutomationProperties.Name="Hosts">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
        <TextBlock x:Name="NavHostsLabel" Grid.Column="1" Text="Hosts" VerticalAlignment="Center"/><TextBlock x:Name="SidebarHostBadge" Grid.Column="2" Text="0" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
      </Grid></Button>
<Button x:Name="NavSftp" Click="NavSftp_Click" Style="{StaticResource NavButton}" ToolTip="Files" AutomationProperties.Name="Files">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
        <TextBlock x:Name="NavSftpLabel" Grid.Column="1" Text="Files" VerticalAlignment="Center"/>
      </Grid></Button>
<Button x:Name="NavKeys" Click="NavKeys_Click" Style="{StaticResource NavButton}" ToolTip="SSH keys" AutomationProperties.Name="SSH keys">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE8D7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
        <TextBlock x:Name="NavKeysLabel" Grid.Column="1" Text="SSH keys" VerticalAlignment="Center"/><TextBlock x:Name="SidebarKeysBadge" Grid.Column="2" Text="0" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
      </Grid></Button>
<Button x:Name="NavSettings" Click="NavSettings_Click" Style="{StaticResource NavButton}" ToolTip="Settings" AutomationProperties.Name="Settings">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
        <TextBlock x:Name="NavSettingsLabel" Grid.Column="1" Text="Settings" VerticalAlignment="Center"/>
      </Grid></Button>
            </StackPanel>
            <Grid x:Name="ActiveTerminalsSection" Visibility="Collapsed" Margin="0,18,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock x:Name="SessionsLabel" Text="Open terminals" Foreground="{DynamicResource Muted}" FontSize="11" Margin="12,0,0,8"/>
              <ListBox Grid.Row="1" x:Name="SidebarSessionsList" ItemTemplate="{StaticResource SessionRow}" SelectionChanged="SidebarSessions_SelectionChanged" PreviewMouseRightButtonDown="SidebarSession_RightClick" AutomationProperties.Name="Open terminal sessions">
                <ListBox.ContextMenu><ContextMenu>
                  <MenuItem Header="Reconnect" Tag="reconnect" Click="SidebarSessionAction_Click"/>
                  <MenuItem Header="Disconnect" Tag="disconnect" Click="SidebarSessionAction_Click"/>
                  <MenuItem Header="Open files" Tag="files" Click="SidebarSessionAction_Click"/>
                  <Separator/><MenuItem Header="Close session" Tag="close" Click="SidebarSessionAction_Click"/>
                </ContextMenu></ListBox.ContextMenu>
              </ListBox>
            </Grid>
          </DockPanel>
        </Border>

        <!-- Right Workspace: Multi-Page Content Area -->
        <Grid Grid.Column="1">

          <Grid x:Name="DashboardPage" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="24,24" MaxWidth="1120" HorizontalAlignment="Stretch">
                <TextBlock Text="Overview" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Your next connection starts here." Foreground="{DynamicResource Muted}" Margin="0,4,0,24"/>
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,24">
                  <StackPanel>
                    <TextBlock Text="Quick connect" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Enter user@host:port. Your saved hosts are available in search." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <DockPanel>
                      <Button Content="Connect" Click="QuickConnect_Click" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Padding="20,7" Margin="12,0,0,0"/>
                      <TextBox x:Name="QuickConnectInput" AutomationProperties.Name="Quick connection endpoint" FontFamily="{StaticResource MonoFont}" MinHeight="36" KeyDown="QuickConnectInput_KeyDown"/>
                    </DockPanel>
                  </StackPanel>
                </Border>
                <WrapPanel Margin="0,0,0,16">
                  <Button Content="Add host" Click="DashboardNewHost_Click" Margin="0,0,8,8"/>
                  <Button Content="Import SSH config" Click="ImportSshConfig_Click" Margin="0,0,8,8"/>
                  <Button Content="Refresh" Click="RefreshDashboard_Click" Style="{StaticResource GhostButton}" Margin="0,0,0,8"/>
                </WrapPanel>
                <Grid x:Name="OverviewColumns">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel x:Name="RecentSection">
                    <TextBlock Text="Recent connections" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="RecentEmpty" Text="Connected hosts will appear here." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                    <ListBox x:Name="DashboardHostsList" SelectionChanged="DashboardHosts_SelectionChanged" ItemTemplate="{StaticResource OverviewHostRow}"/>
                  </StackPanel>
                  <StackPanel x:Name="FavoritesSection" Grid.Column="2">
                    <TextBlock Text="Favorite hosts" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="FavoritesEmpty" Text="Favorite a host to keep it within reach." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                    <ListBox x:Name="FavoriteHostsList" ItemTemplate="{StaticResource OverviewHostRow}"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Active sessions" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,10"/>
                <TextBlock x:Name="SessionsEmpty" Text="No open sessions. Connect to a host to open a terminal." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <ListBox x:Name="OverviewSessionsList" MaxHeight="200" ItemTemplate="{StaticResource SessionRow}" SelectionChanged="OverviewSession_SelectionChanged"/>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,16,0,0">
                  <UniformGrid x:Name="DashboardCards" Columns="4">
                    <StackPanel><TextBlock Text="Saved hosts" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="MetricHostsCount" Text="0" FontSize="18" Margin="0,4,0,0"/><TextBlock x:Name="MetricHostsBreakdown" Visibility="Collapsed"/></StackPanel>
                    <StackPanel><TextBlock Text="Connected sessions" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="MetricActiveSessions" Text="0" FontSize="18" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel><TextBlock Text="SSH identities" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="MetricKeysCount" Text="0" FontSize="18" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel><TextBlock Text="Local service" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="BackendReadyText" Text="Starting" FontSize="18" Margin="0,4,0,0"/></StackPanel>
                  </UniformGrid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- TAB 2: HOSTS INVENTORY & INSPECTOR -->
          <Grid x:Name="HostsPage" Visibility="Collapsed">

            <!-- List View Mode -->
            <Grid x:Name="HostListGrid" Visibility="Visible">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="300"/>
              </Grid.ColumnDefinitions>

              <!-- Left Main Column: Hosts Catalog -->
              <DockPanel Grid.Column="0" Margin="24,20,16,20">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                  <TextBlock Text="Hosts" FontSize="22" FontWeight="SemiBold"/>
                  <TextBlock x:Name="HostCount" Text="0 saved hosts" Foreground="{DynamicResource Muted}" Margin="0,4,0,14"/>
                  <WrapPanel>
                    <Button Content="New host" Click="NewHost_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"/>
                    <Button Content="Import SSH config" Click="ImportSshConfig_Click" Margin="0,0,8,4"/>
                    <Button Content="Details" Click="ToggleInspector_Click" Style="{StaticResource GhostButton}" Margin="0,0,0,4"/>
                  </WrapPanel>
                </StackPanel>

                <!-- Search and Filters Bar -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                  <!-- Tag Filter Buttons -->
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0">
                    <Button x:Name="FilterAll" Content="All" Click="FilterAll_Click" Style="{StaticResource OutlineButton}" Height="34" Padding="12,0" Margin="0,0,6,0"/>
                    <Button x:Name="FilterFav" Content="Favorites" Click="FilterFav_Click" Style="{StaticResource OutlineButton}" Height="34" Padding="12,0"/>
                  </StackPanel>

                  <!-- Search Box -->
                  <Grid VerticalAlignment="Center">
                    <TextBox x:Name="Search" AutomationProperties.Name="Filter saved hosts" Height="34" TextChanged="Search_Changed" Padding="10,0" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="SearchHint" Text="Search hosts by name, address, or tag..." Foreground="{DynamicResource MutedSubtle}" FontSize="12" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  </Grid>
                </DockPanel>

<TextBlock x:Name="HostsEmpty" DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="HostGridButton" Content="Grid" Click="HostGrid_Click" AutomationProperties.Name="Show host cards" Margin="0,0,8,0"/>
                    <Button x:Name="HostListButton" Content="List" Click="HostList_Click" AutomationProperties.Name="Show host list"/>
                  </StackPanel>
                  <ComboBox x:Name="HostSort" SelectedIndex="0" SelectionChanged="HostSort_Changed" HorizontalAlignment="Left" Margin="0,0,0,8" Width="180" AutomationProperties.Name="Sort hosts">
                    <ComboBoxItem Content="Name" Tag="name"/><ComboBoxItem Content="Recent connections" Tag="recent"/><ComboBoxItem Content="Favorites first" Tag="favorite"/>
                </ComboBox></DockPanel>
                <!-- Hosts List -->
                <ListBox x:Name="Hosts" SelectionChanged="Hosts_SelectionChanged" PreviewMouseRightButtonDown="SidebarSession_RightClick" AutomationProperties.Name="Saved hosts">
                  <ListBox.ContextMenu><ContextMenu><MenuItem Header="Connect" Click="DetailConnect_Click"/><MenuItem Header="Edit" Click="DetailEdit_Click"/><MenuItem Header="Favorite" Click="DetailFavorite_Click"/><MenuItem Header="Delete" Click="DetailRemove_Click"/></ContextMenu></ListBox.ContextMenu>
                  <ListBox.Resources>
                    <DataTemplate x:Key="HostListTemplate">
                      <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,12" Margin="0,0,0,2">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Muted}" ToolTip="{Binding Description}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding TagSummary}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Favorite" Foreground="{DynamicResource AccentYellow}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Connect" Tag="{Binding}" Click="HostItemConnect_Click"/>
                            <TextBlock Text="{Binding ConnectionStatus}" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  <DataTemplate x:Key="HostGridTemplate">
                      <Border x:Name="HostCardSurface" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="16">
    <StackPanel>
      <DockPanel Margin="0,0,0,12">
        <TextBlock DockPanel.Dock="Right" Text="Favorite" Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource AccentCyan}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <Border Width="58" Height="34" HorizontalAlignment="Left" Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
          <TextBlock Text="{Binding OsBadge}" ToolTip="Label inferred from host name and tags" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
      </DockPanel>
      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}" ToolTip="{Binding Name}"/>
      <TextBlock Text="{Binding Description}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/>
      <TextBlock Text="{Binding TagSummary}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedSubtle}" Margin="0,8,0,16"/>
      <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Margin="0,0,0,12">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ConnectionStatus}" Value="Connected"><Setter Property="Foreground" Value="{DynamicResource StatusOnline}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <WrapPanel>
        <Button Content="Connect" Tag="{Binding}" Click="HostItemConnect_Click" Style="{StaticResource OutlineButton}" Padding="14,5" Margin="0,0,6,0"/>
        <Button Content="Details" Tag="{Binding}" Click="HostCardDetails_Click" Style="{StaticResource GhostButton}"/>
      </WrapPanel>
    </StackPanel>
  </Border>
<DataTemplate.Triggers>
  <Trigger SourceName="HostCardSurface" Property="IsMouseOver" Value="True">
    <Setter TargetName="HostCardSurface" Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
  </Trigger>
</DataTemplate.Triggers>
</DataTemplate></ListBox.Resources>
                </ListBox>
              </DockPanel>

              <!-- Right Column: Host Detail Inspector -->
              <Border x:Name="HostInspector" Grid.Column="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <ScrollViewer Margin="20">
                  <StackPanel x:Name="InspectorPanel">
                    <Button Content="Close details" Click="ToggleInspector_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                    <TextBlock Text="Host details" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedSubtle}" Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                      <StackPanel>
                        <TextBlock x:Name="DetailTitle" Text="Select a host" TextWrapping="Wrap" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Text}"/>
                        <TextBlock x:Name="DetailSubtitle" Text="Choose a server to inspect configuration" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>

                    <!-- Specs List -->
                    <Border Background="{DynamicResource CardLow}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock Text="Address" Foreground="{DynamicResource MutedSubtle}" FontSize="11"/>
                          <TextBlock x:Name="DetailAddress" Text="-" MaxWidth="150" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text}" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock Text="Port" Foreground="{DynamicResource MutedSubtle}" FontSize="11"/>
                          <TextBlock x:Name="DetailPort" Text="22" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text}" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock Text="Username" Foreground="{DynamicResource MutedSubtle}" FontSize="11"/>
                          <TextBlock x:Name="DetailUser" Text="-" MaxWidth="150" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text}" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel>
                          <TextBlock Text="Auth Mode" Foreground="{DynamicResource MutedSubtle}" FontSize="11"/>
                          <TextBlock x:Name="DetailAuth" Text="Keypair" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentCyan}" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>
                      </StackPanel>
                    </Border>

                    <!-- Inspector Actions -->
                    <Button x:Name="DetailConnectBtn" Content="Connect Terminal" Click="DetailConnect_Click" Style="{StaticResource PrimaryButton}" Height="36" Margin="0,0,0,8"/>
                    <Button x:Name="DetailEditBtn" Content="Edit Configuration" Click="DetailEdit_Click" Style="{StaticResource OutlineButton}" Height="34" Margin="0,0,0,8"/>
                    <Button x:Name="DetailFavBtn" Content="Toggle Favorite" Click="DetailFavorite_Click" Style="{StaticResource GhostButton}" Height="30" Margin="0,0,0,8"/>
                    <Button x:Name="DetailRemoveBtn" Content="Delete Host" Click="DetailRemove_Click" Style="{StaticResource GhostButton}" Foreground="{DynamicResource StatusError}" Height="30"/>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>

            <!-- Full-Page Host Editor Mode -->
            <Grid x:Name="HostEditorGrid" Visibility="Collapsed" Background="{DynamicResource Surface}">
              <DockPanel MaxWidth="680" HorizontalAlignment="Left">
                <StackPanel DockPanel.Dock="Bottom" Margin="24,12">
                  <TextBlock x:Name="EditorError" Foreground="{DynamicResource AccentYellow}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                  <WrapPanel>
                    <Button Content="Save and connect" Click="EditorSaveAndConnect_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/>
                    <Button Content="Save host" Click="EditorSave_Click" Margin="0,0,12,0"/>
                    <Button Content="Cancel" Click="EditorCancel_Click"/>
                  </WrapPanel>
                </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Margin="24,16">
                  <StackPanel>
                    <Button Content="&#x2190; Back to hosts" Click="EditorCancel_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                    <TextBlock x:Name="EditorHeader" Text="New host" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="Enter an address or paste user@host:port. Choose how to sign in." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,16"/>

                    <!-- Section 1: Server Details -->
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                      <StackPanel>
                        <TextBlock Text="Connection" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Label Content="_Server address" Target="{Binding ElementName=EditorHost}" Padding="0" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                            <TextBox x:Name="EditorHost" AutomationProperties.Name="Server address" Height="34"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <Label Content="SSH _port" Target="{Binding ElementName=EditorPort}" Padding="0" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                            <TextBox x:Name="EditorPort" AutomationProperties.Name="SSH port" Text="22" Height="34"/>
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="Remote Username" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EditorUser" AutomationProperties.Name="Remote username" Height="34" Margin="0,0,0,12"/>

                        <TextBlock Text="Authentication method" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="EditorAuth" AutomationProperties.Name="Authentication method" SelectedIndex="0" Margin="0,0,0,12" SelectionChanged="EditorAuth_Changed">
                          <ComboBoxItem Content="SSH key" Tag="key"/>
                          <ComboBoxItem Content="Password" Tag="password"/>
                          <ComboBoxItem Content="Keyboard interactive" Tag="keyboard_interactive"/>
                        </ComboBox>
                        <TextBlock x:Name="EditorAuthHint" Text="Choose an existing private key. Its contents stay on this computer." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                        <StackPanel x:Name="EditorKeySection">
                          <TextBlock Text="Choose a key" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                          <ComboBox x:Name="EditorIdentity" AutomationProperties.Name="SSH key on this computer or saved key" DisplayMemberPath="SelectionLabel" SelectionChanged="EditorIdentity_Changed" Margin="0,0,0,8"/>
                          <TextBox x:Name="EditorKeyPath" AutomationProperties.Name="Private key file" IsReadOnly="True" Visibility="Collapsed"/>
                          <TextBlock x:Name="EditorKeyDetails" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                          <WrapPanel>
                            <Button Content="Choose another file" Click="EditorBrowseKey_Click" Margin="0,0,8,4"/>
                            <Button Content="Generate key" Click="GenerateKeypair_Click" Margin="0,0,8,4"/>
                            <Button Content="Refresh local keys" Click="DiscoverKeys_Click" Margin="0,0,0,4"/>
                          </WrapPanel>
                        </StackPanel>
                        <Label Content="Display _name (optional)" Target="{Binding ElementName=EditorName}" Padding="0" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,12,0,4"/>
                        <TextBox x:Name="EditorName" AutomationProperties.Name="Host display name" Height="34"/>
                        <TextBlock Text="Uses the server address if left blank." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>

                    <!-- Section 3: Advanced Details -->
                    <Expander x:Name="EditorAdvanced" Header="Advanced options: jump host, tags and notes" Foreground="{DynamicResource Text}" Margin="0,0,0,16">
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24">
                      <StackPanel>
                        <TextBlock Text="Advanced connection options" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
                        <TextBlock Text="Jump Host (ProxyJump)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EditorJump" AutomationProperties.Name="Jump host" Height="34" Margin="0,0,0,12"/>

                        <TextBlock Text="Tags (comma-separated)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EditorTags" AutomationProperties.Name="Tags" Height="34" Margin="0,0,0,12"/>

                        <TextBlock Text="Notes" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EditorNotes" AutomationProperties.Name="Host notes" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                    </Expander>


                  </StackPanel>
                </Border>
              </ScrollViewer>
              </DockPanel>
            </Grid>
          </Grid>

          <!-- TAB 3: SFTP FILE TRANSFER CENTER -->
          <Grid x:Name="SftpPage" Visibility="Collapsed">
            <DockPanel Margin="24,20">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Files" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Browse locally. Transfer securely." Foreground="{DynamicResource Muted}" Margin="0,4,0,14"/>
                <ComboBox x:Name="SftpSessionCombo" AutomationProperties.Name="File browser SSH session" MaxWidth="480" HorizontalAlignment="Stretch" DisplayMemberPath="SelectionLabel" SelectionChanged="SftpSessionCombo_SelectionChanged"/>
              </StackPanel>

              <ScrollViewer x:Name="FileViewport" SizeChanged="FileViewport_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ContentControl x:Name="SftpContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Connect a host to browse files" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Choose a connected session above. Local and remote folders will open side by side." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"/>
                  </StackPanel>
                </Border>
              </ContentControl>
              </ScrollViewer>
            </DockPanel>
          </Grid>

          <!-- TAB 4: KEY VAULT CRYPTOGRAPHIC MANAGER -->
          <Grid x:Name="KeysPage" Visibility="Collapsed">
            <DockPanel Margin="24,20">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Text="SSH keys" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Your identities, kept on this computer." Foreground="{DynamicResource Muted}" Margin="0,4,0,14"/>
                <WrapPanel>
                  <Button Content="Add key" Click="RegisterKey_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"/>
                  <Button Content="Generate key" Click="GenerateKeypair_Click" Margin="0,0,8,4"/>
                  <Button Content="Find local keys" Click="DiscoverKeys_Click" Style="{StaticResource GhostButton}" Margin="0,0,0,4"/>
                </WrapPanel>
                <TextBlock x:Name="KeysEmpty" Text="No identities found. Add an existing key or generate one to get started." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
              </StackPanel>

              <!-- Keys List -->
              <ListBox x:Name="KeysList">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding AlgorithmBadge}" Foreground="{DynamicResource AccentCyan}" FontSize="11" Margin="12,0,0,0"/>
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,12"/>
                        <WrapPanel>
                          <Button Content="Copy public key" Tag="{Binding}" IsEnabled="{Binding HasPublicKey}" Click="CopyPubKey_Click" Margin="0,0,8,4"/>
                          <Button Content="Remove" Tag="{Binding}" IsEnabled="{Binding CanRemove}" Click="RemoveKey_Click" Style="{StaticResource GhostButton}" Foreground="{DynamicResource StatusError}" Margin="0,0,0,4"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>

          <!-- TAB 5: SETTINGS & PREFERENCES -->
          <Grid x:Name="SettingsPage" Visibility="Collapsed">
            <Grid Margin="24,20">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsNavColumn" Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel x:Name="SettingsNav" Margin="0,4,16,0">
                <Button Content="Appearance" Tag="AppearanceSection" Click="SettingsSection_Click" Style="{StaticResource NavButton}"/>
                <Button Content="Terminal" Tag="TerminalSection" Click="SettingsSection_Click" Style="{StaticResource NavButton}"/>
                <Button Content="Workspaces" Tag="DataSection" Click="SettingsSection_Click" Style="{StaticResource NavButton}"/>
                <Button Content="Updates" Tag="UpdatesSection" Click="SettingsSection_Click" Style="{StaticResource NavButton}"/>
                <Button Content="Diagnostics" Tag="DiagnosticsSection" Click="SettingsSection_Click" Style="{StaticResource NavButton}"/>
                <Button Content="Security" Tag="SecuritySection" Click="SettingsSection_Click" Style="{StaticResource NavButton}"/>
              </StackPanel>
              <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                <TextBlock Text="Make this workspace yours." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,24"/>

                <!-- Theme Selection Card -->
                <Border x:Name="AppearanceSection" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,16,20">
                  <StackPanel>
                    <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                      <!-- Dark -->
                      <Button Content="Dark" Click="SetDarkTheme_Click" Style="{StaticResource OutlineButton}" Height="38" Padding="16,0" Margin="0,0,12,0"/>
                      <!-- Light -->
                      <Button Content="Light" Click="SetLightTheme_Click" Style="{StaticResource OutlineButton}" Height="38" Padding="16,0"/>
                    </StackPanel>
                    <CheckBox x:Name="ReducedMotion" Content="Reduce animations" Margin="0,8"/>


                  </StackPanel>
                </Border>

                <!-- Terminal Typography Card -->
                <Border x:Name="UpdatesSection" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,16,20">
                  <StackPanel>
                    <TextBlock Text="Updates" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="UpdateStatus" Text="Connect the local service to check the installed version." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ProgressBar x:Name="UpdateProgress" AutomationProperties.Name="Update download progress" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,12"/>
                    <WrapPanel>
                      <Button x:Name="UpdateCheckButton" Content="Check for updates" Click="CheckUpdate_Click" IsEnabled="False" Margin="0,0,8,0"/>
                      <Button x:Name="UpdateInstallButton" Content="Install and restart" Click="InstallUpdate_Click" Visibility="Collapsed" Style="{StaticResource PrimaryButton}"/>
                    </WrapPanel>
                    <TextBlock Text="No uninstall needed. Saved hosts, preferences and local key files stay in place." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
                <Border x:Name="TerminalSection" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,16,20">
                  <StackPanel>
                    <TextBlock Text="Terminal" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <TextBlock Text="Font family" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SettingsFontFamily" AutomationProperties.Name="Terminal font family" SelectedIndex="0" Margin="0,0,0,12">
                      <ComboBoxItem Content="Cascadia Code"/><ComboBoxItem Content="Consolas"/><ComboBoxItem Content="Cascadia Mono"/>
                    </ComboBox>
                    <TextBlock Text="Line height" Margin="0,0,0,6"/>
                    <TextBox x:Name="SettingsLineHeight" AutomationProperties.Name="Terminal line height" Text="1.15" Height="34" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Font size (pixels)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SettingsFontSize" AutomationProperties.Name="Terminal font size" Text="13" Height="34" VerticalContentAlignment="Center"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Scrollback lines" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SettingsScrollback" AutomationProperties.Name="Terminal scrollback lines" Text="5000" Height="34" VerticalContentAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border x:Name="DataSection" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,16,20">
                  <StackPanel>
                    <TextBlock Text="Workspaces and data" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,0,12"/>
                    <ComboBox x:Name="WorkspaceList" AutomationProperties.Name="Saved workspace" DisplayMemberPath="Name" Margin="0,0,0,12"/>
                    <WrapPanel>
                      <Button Content="Save workspace" Click="SaveWorkspace_Click" Margin="0,0,8,8"/>
                      <Button Content="Restore workspace" Click="RestoreWorkspace_Click" Margin="0,0,8,8"/>
                      <Button Content="Back up databases" Click="Backup_Click" Margin="0,0,8,8"/>
                      <Button Content="Export hosts" Click="ExportHosts_Click" Margin="0,0,8,8"/>
                      <Button Content="Import hosts" Click="ImportHosts_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Text="Restore reconnects saved hosts after confirmation and prompts for credentials. Backups contain host, workspace, public-key metadata and preferences; private-key files and connection passwords are excluded." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                  </StackPanel>
                </Border>
                <Border x:Name="DiagnosticsSection" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,16,20">
                  <StackPanel>
                    <TextBlock Text="Diagnostics" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DaemonStatusText" Text="Checking local service..." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DaemonUptimeText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Button Content="Refresh diagnostics" Click="RefreshDiagnostics_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
                <!-- Identity & Lock Vault Card -->
                <Border x:Name="SecuritySection" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,16,20">
                  <StackPanel>
                    <TextBlock Text="Session security" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,0,12"/>
                    <TextBlock Text="Passwords and key passphrases are entered for each connection and kept in memory. This app has no cloud account or master vault. Locking Windows protects access to the desktop; SSH sessions continue until disconnected or the app closes." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="Lock Windows" Click="LockVault_Click" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
              <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Save preferences" Click="SaveSettings_Click" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/>
                  <TextBlock x:Name="SettingsError" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- TAB 6: ACTIVE TERMINAL SESSION WORKSPACE (When connected) -->
          <Grid x:Name="SessionTerminalWorkspace" Visibility="Collapsed">
            <TabControl x:Name="SessionTabs" SelectionChanged="SessionTabs_SelectionChanged"/>
          </Grid>
        </Grid>
      </Grid>

      <Border x:Name="RecoveryPanel" Grid.Row="1" VerticalAlignment="Top" Panel.ZIndex="10" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="16" Margin="220,12,20,0" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="RecoveryMessage" Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <WrapPanel>
            <Button Content="Retry" Click="RetryOperation_Click" Margin="0,0,8,0"/>
            <Button Content="Edit host" Click="RecoveryEdit_Click" Margin="0,0,8,0"/>
            <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click" Margin="0,0,8,0"/>
            <Button Content="Dismiss" Click="DismissRecovery_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <!-- Bottom Status Bar -->
      <Grid Grid.Row="2" Background="{DynamicResource CardLow}">
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"/>
        <Grid Margin="14,0" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,16,0"/>
          <TextBlock Grid.Column="1" Text="Ctrl K  Search and connect" Foreground="{DynamicResource Muted}" FontSize="11"/>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
