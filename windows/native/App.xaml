<Application x:Class="SSHClient.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#121419" />
    <SolidColorBrush x:Key="Text" Color="#E8E9ED" />
    <SolidColorBrush x:Key="Border" Color="#30343C" />
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style TargetType="Control"><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#252932"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#1D2027"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#1D2027"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#171A20"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/></Style>
    <Style TargetType="TabItem"><Setter Property="Background" Value="#252932"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="14,8"/></Style>
  </Application.Resources>
</Application>
