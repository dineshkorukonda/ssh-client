# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets will end up here.
/cover/

# The directory Mix will keep dependencies in.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore the files generated by hex package.
*.ez

# Runtime and editor files
*.swp
*~
__pycache__/
*.pyc
/node_modules/

.worktrees/
/windows/native/bin/
/windows/native/obj/
/windows/native/publish/
/windows/runtime/
/installer/
native-smoke*.png
native-smoke-error.txt
stitch_ui_assets/
tmp/
