<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>ssh-client</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/images/icon.png" />

    <!-- Poppins font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- daisyUI via CDN -->
    <link
      href="https://cdn.jsdelivr.net/npm/daisyui@4.12.14/dist/full.min.css"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- xterm.js -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.min.js"></script>
    <script>
      window.TerminalHook = {
        mounted() {
          const el = this.el;
          const lv = this;

          if (typeof Terminal === 'undefined') {
            el.innerHTML = '<div style="color:#ef4444;font-family:monospace;padding:1rem">xterm.js not loaded</div>';
            return;
          }

          let currentFontSize = 13;

          const term = new Terminal({
            cursorBlink: true,
            fontSize: currentFontSize,
            lineHeight: 1.25,
            fontFamily: "'JetBrains Mono', 'Menlo', 'Consolas', 'Courier New', monospace",
            allowTransparency: true,
            scrollback: 10000,
            theme: {
              background: '#050505',
              foreground: '#e4e4e7',
              cursor:     '#3b82f6',
              cursorAccent: '#050505',
              selectionBackground: 'rgba(59, 130, 246, 0.35)',
              selectionForeground: '#ffffff',
              black:      '#050505',
              brightBlack:'#3f3f46',
              red:        '#ef4444',
              brightRed:  '#f87171',
              blue:       '#3b82f6',
              brightBlue: '#60a5fa',
              cyan:       '#06b6d4',
              brightCyan: '#22d3ee',
              green:      '#22c55e',
              brightGreen:'#4ade80',
              yellow:     '#eab308',
              brightYellow:'#fde047',
              magenta:    '#d946ef',
              brightMagenta: '#f472b6',
              white:      '#e4e4e7',
              brightWhite:'#fafafa'
            }
          });

          const fitAddon = (typeof FitAddon !== 'undefined') ? new FitAddon.FitAddon() : null;
          if (fitAddon) term.loadAddon(fitAddon);

          term.open(el);

          // Sizing logic with FitAddon
          const doFit = () => {
            if (!fitAddon || !el.clientWidth || !el.clientHeight) return;
            try {
              fitAddon.fit();
              if (term.cols > 0 && term.rows > 0) {
                lv.pushEvent("resize", { cols: term.cols, rows: term.rows });
              }
            } catch(e) {
              console.debug("fit error:", e);
            }
          };

          // Initial multi-stage fit to ensure dimensions calculate after rendering
          requestAnimationFrame(doFit);
          setTimeout(doFit, 30);
          setTimeout(doFit, 150);
          setTimeout(doFit, 400);

          // ResizeObserver for dynamic layout / split view / fullscreen changes
          let resizeObserver = null;
          if (window.ResizeObserver) {
            resizeObserver = new ResizeObserver(() => {
              requestAnimationFrame(doFit);
            });
            resizeObserver.observe(el);
          }

          term.writeln('\x1b[1;34mssh-client\x1b[0m \x1b[2mv0.0.1\x1b[0m');
          term.writeln('\x1b[2mConnecting to ' + (el.dataset.serverId || 'server') + '...\x1b[0m');
          term.writeln('');

          lv.pushEvent("terminal_ready", {});

          // LiveView -> Terminal events
          this.handleEvent("terminal_output", ({ data }) => {
            term.write(data);
          });

          this.handleEvent("terminal_paste", () => {
            if (navigator.clipboard && navigator.clipboard.readText) {
              navigator.clipboard.readText().then(text => {
                if (text) lv.pushEvent("terminal_data", { data: text });
              }).catch(err => {
                console.warn("Clipboard read error:", err);
              });
            }
          });

          this.handleEvent("terminal_insert_command", ({ command, execute }) => {
            const data = execute ? (command + "\n") : command;
            lv.pushEvent("terminal_data", { data: data });
            term.focus();
          });

          this.handleEvent("terminal_clear", () => {
            term.clear();
          });

          this.handleEvent("terminal_font_change", ({ delta }) => {
            currentFontSize = Math.max(9, Math.min(24, currentFontSize + delta));
            term.options.fontSize = currentFontSize;
            requestAnimationFrame(doFit);
          });

          // Terminal -> LiveView data stream
          term.onData(function(data) {
            lv.pushEvent("terminal_data", { data: data });
          });

          // Auto-copy on text selection
          term.onSelectionChange(() => {
            const selection = term.getSelection();
            if (selection && selection.trim().length > 0) {
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(selection).catch(() => {});
              }
            }
          });

          // Keyboard copy & paste handlers
          term.attachCustomKeyEventHandler((e) => {
            // Ctrl+C / Cmd+C: Copy if selection exists, else send SIGINT
            if ((e.ctrlKey || e.metaKey) && (e.key === 'c' || e.key === 'C') && e.type === 'keydown') {
              if (term.hasSelection()) {
                const sel = term.getSelection();
                if (navigator.clipboard && navigator.clipboard.writeText) {
                  navigator.clipboard.writeText(sel).catch(() => {});
                }
                return false; // Prevent xterm from sending ^C byte
              }
              return true; // No selection: send ^C to remote shell
            }

            // Ctrl+V / Cmd+V / Ctrl+Shift+V: Paste from clipboard
            if ((e.ctrlKey || e.metaKey) && (e.key === 'v' || e.key === 'V') && e.type === 'keydown') {
              if (navigator.clipboard && navigator.clipboard.readText) {
                navigator.clipboard.readText().then(text => {
                  if (text) lv.pushEvent("terminal_data", { data: text });
                }).catch(() => {});
                return false;
              }
            }

            // Ctrl+Plus / Ctrl+Minus: Font size scaling
            if ((e.ctrlKey || e.metaKey) && (e.key === '=' || e.key === '+') && e.type === 'keydown') {
              currentFontSize = Math.min(24, currentFontSize + 1);
              term.options.fontSize = currentFontSize;
              requestAnimationFrame(doFit);
              return false;
            }
            if ((e.ctrlKey || e.metaKey) && (e.key === '-' || e.key === '_') && e.type === 'keydown') {
              currentFontSize = Math.max(9, currentFontSize - 1);
              term.options.fontSize = currentFontSize;
              requestAnimationFrame(doFit);
              return false;
            }

            return true;
          });

          // Right click context menu
          el.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            const existingMenu = document.getElementById('term-context-menu');
            if (existingMenu) existingMenu.remove();

            const menu = document.createElement('div');
            menu.id = 'term-context-menu';
            menu.className = 'fixed z-50 bg-[#111111] border border-[#27272a] rounded-lg shadow-2xl py-1 text-xs font-mono text-zinc-300 w-48 select-none backdrop-blur-md';
            menu.style.left = `${Math.min(e.clientX, window.innerWidth - 200)}px`;
            menu.style.top = `${Math.min(e.clientY, window.innerHeight - 200)}px`;

            const hasSel = term.hasSelection();

            menu.innerHTML = `
              <div id="ctx-paste" class="px-3 py-1.5 hover:bg-[#222] hover:text-white cursor-pointer flex items-center justify-between">
                <span>📋 Paste Clipboard</span>
                <span class="text-[10px] text-zinc-500">Ctrl+V</span>
              </div>
              <div id="ctx-copy" class="px-3 py-1.5 hover:bg-[#222] hover:text-white cursor-pointer flex items-center justify-between ${hasSel ? '' : 'opacity-40 pointer-events-none'}">
                <span>📄 Copy Selection</span>
                <span class="text-[10px] text-zinc-500">Ctrl+C</span>
              </div>
              <div id="ctx-select-all" class="px-3 py-1.5 hover:bg-[#222] hover:text-white cursor-pointer flex items-center justify-between">
                <span>🔍 Select All</span>
                <span class="text-[10px] text-zinc-500">Ctrl+A</span>
              </div>
              <div class="h-[1px] bg-[#222] my-1"></div>
              <div id="ctx-zsh" class="px-3 py-1.5 hover:bg-[#222] hover:text-white cursor-pointer flex items-center justify-between text-blue-400">
                <span>🐚 Switch to Zsh</span>
              </div>
              <div id="ctx-clear" class="px-3 py-1.5 hover:bg-[#222] hover:text-white cursor-pointer flex items-center justify-between text-red-400">
                <span>🧹 Clear Buffer</span>
                <span class="text-[10px] text-zinc-500">Ctrl+L</span>
              </div>
            `;

            document.body.appendChild(menu);

            const removeMenu = () => {
              if (menu.parentNode) menu.parentNode.removeChild(menu);
              document.removeEventListener('click', removeMenu);
            };
            setTimeout(() => document.addEventListener('click', removeMenu), 10);

            document.getElementById('ctx-paste')?.addEventListener('click', () => {
              if (navigator.clipboard && navigator.clipboard.readText) {
                navigator.clipboard.readText().then(text => {
                  if (text) lv.pushEvent("terminal_data", { data: text });
                });
              }
              term.focus();
            });

            document.getElementById('ctx-copy')?.addEventListener('click', () => {
              const sel = term.getSelection();
              if (sel && navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(sel);
              }
              term.focus();
            });

            document.getElementById('ctx-select-all')?.addEventListener('click', () => {
              term.selectAll();
            });

            document.getElementById('ctx-zsh')?.addEventListener('click', () => {
              lv.pushEvent("terminal_data", { data: "exec zsh -l\n" });
              term.focus();
            });

            document.getElementById('ctx-clear')?.addEventListener('click', () => {
              term.clear();
              term.focus();
            });
          });

          window.addEventListener('resize', doFit);
          this.doFit = doFit;
          this.resizeObserver = resizeObserver;
          this.term = term;
        },
        destroyed() {
          if (this.doFit) window.removeEventListener('resize', this.doFit);
          if (this.resizeObserver) this.resizeObserver.disconnect();
          const menu = document.getElementById('term-context-menu');
          if (menu) menu.remove();
          if (this.term) this.term.dispose();
        }
      };
    </script>

    <style>
      :root {
        --app-bg: #050505;
        --sidebar-bg: #0a0a0a;
        --panel-bg: #111111;
        --border: #1f1f1f;
        --accent: #2563eb;
        --accent-hover: #3b82f6;
        --text-primary: #f5f5f5;
        --text-muted: #6b7280;
        --text-dim: #374151;
      }

      html, body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--app-bg);
        color: var(--text-primary);
        height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
      }

      code, pre, .mono {
        font-family: 'JetBrains Mono', monospace;
      }

      /* xterm full container filling */
      .xterm {
        height: 100%;
        width: 100%;
        padding: 6px;
      }
      .xterm-viewport {
        height: 100% !important;
        background-color: transparent !important;
      }
      .xterm-screen {
        height: 100% !important;
      }

      /* Scrollbar */
      ::-webkit-scrollbar { width: 4px; height: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: #27272a; border-radius: 2px; }
    </style>
  </head>
  <body class="h-full bg-[#050505] text-[#f5f5f5]">
    {@inner_content}

    <!-- Phoenix & LiveView JS client -->
    <script src="https://cdn.jsdelivr.net/npm/phoenix@1.8.13/priv/static/phoenix.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/phoenix_live_view@1.2.11/priv/static/phoenix_live_view.min.js"></script>
    <script>
      (function() {
        const csrfToken = document.querySelector("meta[name='csrf-token']") ? document.querySelector("meta[name='csrf-token']").getAttribute("content") : "";
        const hooks = {};
        if (window.TerminalHook) {
          hooks.TerminalHook = window.TerminalHook;
        }
        window.liveSocketHooks = hooks;

        const Socket = (typeof Phoenix !== 'undefined') ? Phoenix.Socket : (window.Socket || null);
        const LiveSocket = (typeof LiveView !== 'undefined') ? LiveView.LiveSocket : (window.LiveSocket || null);

        if (!Socket || !LiveSocket) {
          console.error("Phoenix or LiveView client library failed to load.", {Socket, LiveSocket});
          return;
        }

        const liveSocket = new LiveSocket("/live", Socket, {
          params: {_csrf_token: csrfToken},
          hooks: hooks
        });

        liveSocket.connect();
        window.liveSocket = liveSocket;
      })();
    </script>
  </body>
</html>
